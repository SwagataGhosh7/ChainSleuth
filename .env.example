# ChainSleuth Environment Variables

# AI Reasoning: Google Gemini API (Server-side)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Inference: Tinker Engine (Optional external LLM orchestrator)
TINKER_API_KEY=""
TINKER_API_URL="https://api.tinker.ai/v1"

# Case Memory: Backboard API (Persistent contextual case knowledge)
BACKBOARD_API_KEY=""
BACKBOARD_API_URL="https://api.backboard.ai/v1"

# Blockchain RPC & Explorers: Polygonscan / Etherscan API
# If empty or rate-limited, built-in deterministic heuristic heist fallback is used seamlessly
POLYGONSCAN_API_KEY=""

# Database: DigitalOcean Managed PostgreSQL
# Format: postgresql://doadmin:secret@db-do-user-1234.b.db.ondigitalocean.com:25060/chainsleuth?sslmode=require
# If empty or unreachable, an in-memory/JSON store fallback is used seamlessly
DATABASE_URL=""

# Network & Host
PORT=3000
APP_URL="MY_APP_URL"
